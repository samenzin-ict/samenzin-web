# Copy to .env and fill in. Never commit .env.
#
# This file documents local development. The deployed environments are
# configured in the Vercel dashboard, not here; see docs/environments.md.

# --- Database ---------------------------------------------------------------
# Local development runs PostgreSQL in Docker: docker compose up -d
DATABASE_URI=postgres://samenzin:samenzin@localhost:5432/samenzin

# Long random string, used to sign login tokens.
# Generate one with: openssl rand -hex 32
# Changing it signs everyone out. Production must not reuse this value.
PAYLOAD_SECRET=

# --- Site address -----------------------------------------------------------
# Inlined into the bundle at build time, not read when the server starts, so it
# has to be right before the build runs. Wrong value means the sitemap, the
# canonical URLs and the /anbi address all point at the wrong host, and the
# ANBI application form carries that address.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Neon, for `pnpm db:pull` ------------------------------------------------
# Read-only as far as this project is concerned: the script copies a branch
# down to the local database and never writes back. Use the pooled connection
# string, the one whose host ends in -pooler.
NEON_DEV_DATABASE_URI=
NEON_PRODUCTION_DATABASE_URI=

# --- Cloudflare R2, for uploaded images and documents ------------------------
# Leave all of these empty locally and uploads are written to ./media instead,
# so a local clone needs no cloud account. Fill them in only if you want your
# machine to write to the shared bucket.
#
# R2_ENDPOINT is https://<account-id>.r2.cloudflarestorage.com
# R2_PUBLIC_URL is the bucket's public address: the r2.dev URL, or a custom
# domain such as https://media.samenzin.org. Without it files are served
# through this application instead of straight from the bucket.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# --- Mollie ------------------------------------------------------------------
# Leave empty until the foundation's bank account and Mollie account exist.
# The donation page ships in a disabled state while these are empty.
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_URL=
