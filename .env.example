# Copy to .env and fill in. Never commit .env.

# Neon. Use the POOLED connection string, the one whose host ends in -pooler.
# Serverless opens a connection per invocation and the direct endpoint runs out.
DATABASE_URI=

# Long random string. Changing it invalidates every existing login.
PAYLOAD_SECRET=
# Local development. In production this is https://samenzin.org.
# It is inlined into the bundle at build time, not read when the server starts,
# so it must be set in the Vercel project before the build runs. Get it wrong
# and the sitemap, the canonical URLs and the /anbi address all point at the
# wrong host. The ANBI application form carries that address, so it matters.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Mollie — leave empty until the foundation's bank account and Mollie account exist.
# The donation page ships in a disabled state while these are empty.
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_URL=

# Vercel Blob, for uploaded images and documents. Vercel sets this by itself
# once a Blob store is connected to the project. Leave it empty locally and
# uploads are written to ./media instead.
BLOB_READ_WRITE_TOKEN=
