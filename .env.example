# Copy to .env and fill in. Never commit .env.

DATABASE_URI=
PAYLOAD_SECRET=
# Local development. In production this is https://samenzin.org and must be passed
# as a Docker build argument: it is inlined into the bundle at build time.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Mollie — leave empty until the foundation's bank account and Mollie account exist.
# The donation page ships in a disabled state while these are empty.
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_URL=
