# Copy this file to .env and read the four sections below.
# Never commit .env.
#
# This file is for LOCAL development only. The deployed environments are
# configured in the Vercel dashboard, not here. See docs/environments.md.
#
# To get running locally you only have to fill in ONE value: PAYLOAD_SECRET.
# Everything else either already works or can stay empty.


# ============================================================================
# 1. REQUIRED — fill this in
# ============================================================================

# Signs login tokens. Any long random string will do.
#   openssl rand -hex 32
# Use a different value here than in production.
PAYLOAD_SECRET=


# ============================================================================
# 2. REQUIRED — already correct, leave as they are
# ============================================================================

# The local database, run by `docker compose up -d`.
# This is the database the app uses. It is NOT Neon.
DATABASE_URI=postgres://samenzin:samenzin@localhost:5432/samenzin

# Where the site thinks it lives. Correct for local development.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Lets the admin panel open an unpublished page on the real site. Any long
# random string; generate one the same way as PAYLOAD_SECRET. Without it the
# preview button returns 503 and everything else keeps working.
PREVIEW_SECRET=

# Authorises the daily clear-out at /api/cron/prune, which deletes personal
# data past its retention date and takes donors' names off gifts older than the
# seven-year obligation. Vercel Cron sends it as "Authorization: Bearer <this>".
#
# Any long random string; generate one the same way as PAYLOAD_SECRET. Without
# it the endpoint answers 503 and nothing is deleted, so the promises in the
# privacyverklaring are not kept. Needed in Production above all; locally you
# only need it to call the endpoint by hand, because `pnpm prune:expired` runs
# the same code without it.
CRON_SECRET=

# Lets `pnpm seed` create members who can sign in, so Mijn omgeving has
# somebody to log in as. Deliberately has no default: a password written into a
# file in this repository would be a credential in version control (CLAUDE.md,
# rule 1) and would be created on whatever database the seed is pointed at.
#
# Prefer passing it per command rather than leaving it here:
#   DEMO_MEMBER_PASSWORD='kies-iets-lang-en-verzonnen' pnpm seed
#
# Never set this in Vercel. It belongs to the seed, which never runs there.
DEMO_MEMBER_PASSWORD=


# ============================================================================
# 3. OPTIONAL — leave empty unless you need them
# ============================================================================

# Cloudflare R2, for uploaded images and documents.
#
# LEAVE THESE EMPTY. With them empty, uploads are written to ./media on your
# own machine and you need no Cloudflare account to work on the site.
#
# Only fill them in if you deliberately want your machine to write into the
# shared bucket, which is rarely what you want.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Neon, used ONLY by `pnpm db:pull` to copy content down to your machine.
# The app never uses these; it uses DATABASE_URI above.
#
# Leave empty until you actually want a copy of the hosted content. Then paste
# the pooled connection strings from the Neon dashboard (host ends in -pooler).
NEON_DEV_DATABASE_URI=
NEON_PRODUCTION_DATABASE_URI=


# ============================================================================
# 4. NOT YET IN USE — leave empty
# ============================================================================

# Mollie. The donation page ships in a disabled state while these are empty,
# which is intended until the foundation's bank account exists.
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_URL=

# E-mail, over SMTP. Nothing is sent while SMTP_HOST is empty: Payload logs the
# recipient and the subject instead, which is what you want locally. No message
# leaves the machine, and no form or approval fails because of it.
#
# Point this at the mailbox the foundation already has, and later at Google
# Workspace. Deliberately SMTP rather than a mail API: no second processor
# handles members' names and addresses, so no extra processing register entry
# and no processor agreement. See src/lib/email/adapter.ts to change provider.
#
# For Gmail or Google Workspace, SMTP_PASS is an app password, never the
# account password. Host smtp.gmail.com, port 587.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Only for a relay that wants implicit TLS on a port other than 465. Port 465
# turns it on by itself; leave this empty otherwise.
SMTP_SECURE=

# Who messages come from. EMAIL_FROM_ADDRESS falls back to SMTP_USER. Many
# relays refuse to send as an address the account does not own, so these two
# usually name the same mailbox as SMTP_USER.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Where "a new message arrived" notifications go. Defaults to the e-mail
# address in Instellingen, so a volunteer can change it without a deploy. Set
# this only to send notifications somewhere other than the public address.
EMAIL_NOTIFY_ADDRESS=
